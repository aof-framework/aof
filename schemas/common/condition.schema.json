{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aof.dev/schema/v1.0/common/condition.schema.json",
  "title": "AOF Condition and Expression Primitives",
  "description": "Consolidated condition/expression primitives. AOF v1.0 does not freeze one universal condition or policy expression language.",
  "$defs": {
    "Condition": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "Expression": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    }
  }
}

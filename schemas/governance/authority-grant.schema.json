{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aof.dev/schema/v1.0/governance/authority-grant.schema.json",
  "title": "AOF AuthorityGrant",
  "allOf": [
    {
      "$ref": "../common/base-object.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "../common/reference.schema.json#/$defs/Reference"
              },
              {
                "$ref": "../common/reference.schema.json#/$defs/Selector"
              }
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "../common/condition.schema.json#/$defs/Condition"
          }
        },
        "issuer": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "delegable": {
          "type": "boolean"
        },
        "delegation_depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "$ref": "../common/governance-enums.schema.json#/$defs/AuthorityStatus"
        },
        "parent_grant_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        }
      },
      "required": [
        "id",
        "subject",
        "operations",
        "resources",
        "scope",
        "constraints",
        "issuer",
        "delegable",
        "delegation_depth",
        "valid_from",
        "valid_until",
        "status",
        "parent_grant_id",
        "provenance"
      ],
      "additionalProperties": true
    }
  ],
  "unevaluatedProperties": false,
  "x-aof": {
    "specification": "AOF v1.0",
    "frozen_baseline_sha256": "57ddbd64671eea615535b20f109064d96fb262e781969ef757a6f4d5efa869d5",
    "source": "Appendix E.15 / Section 11.5-11.23",
    "normative_notes": [
      "NoGrant => Deny.",
      "Only Active and otherwise valid Authority MAY satisfy the Authority predicate.",
      "Delegation conservation remains a semantic/conformance rule, not a structural proof."
    ]
  }
}

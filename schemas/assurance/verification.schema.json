{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aof.dev/schema/v1.0/assurance/verification.schema.json",
  "title": "AOF Verification",
  "allOf": [
    {
      "$ref": "../common/base-object.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_ref": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "criteria_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/reference.schema.json#/$defs/Reference"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/reference.schema.json#/$defs/Reference"
          }
        },
        "verifier": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "profile_ref": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "independence": {
          "$ref": "../common/assurance-types.schema.json#/$defs/VerificationIndependence"
        },
        "result": {
          "$ref": "../common/assurance-types.schema.json#/$defs/VerificationResult"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        }
      },
      "required": [
        "id",
        "claim_ref",
        "criteria_refs",
        "evidence_refs",
        "verifier",
        "method",
        "profile_ref",
        "independence",
        "result",
        "confidence",
        "limitations",
        "subject_version",
        "verified_at",
        "provenance"
      ],
      "additionalProperties": true
    }
  ],
  "unevaluatedProperties": false,
  "x-aof": {
    "specification": "AOF v1.0",
    "frozen_baseline_sha256": "57ddbd64671eea615535b20f109064d96fb262e781969ef757a6f4d5efa869d5",
    "source": "Appendix E.22",
    "normative_notes": [
      "Canonical result is Verified, Rejected, or Inconclusive.",
      "Inconclusive MUST NOT serialize as success-equivalent boolean.",
      "Verification remains distinct from Approval and Authority."
    ],
    "lts_a2_hardened": true
  }
}

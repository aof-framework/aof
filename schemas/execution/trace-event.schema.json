        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "input_refs": {

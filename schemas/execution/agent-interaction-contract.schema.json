        "id": {
          "type": "string",
          "minLength": 1
        },
        "sender": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "receiver": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "task_ref": {
          "$ref": "../common/reference.schema.json#/$defs/Reference"
        },
        "message_type": {
          "$ref": "../common/execution-types.schema.json#/$defs/MessageType"
        },
        "context_refs": {

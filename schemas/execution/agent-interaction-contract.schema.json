            "$ref": "../common/reference.schema.json#/$defs/Reference"
          }
        },
        "authority_context_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/reference.schema.json#/$defs/Reference"
          }
        },
        "constraints": {

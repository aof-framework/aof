      },
      "required": [
        "id",
        "sender",
        "receiver",
        "task_ref",
        "message_type",
        "context_refs",
        "authority_context_refs",
        "constraints",
        "expected_output_schema_ref",
        "disclosure_scope",
        "expires_at"
      ],
      "additionalProperties": true
